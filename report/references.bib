@article{dakin_cosmological_2022,
	title = {The cosmological simulation code \${\textbackslash}scriptstyle\{{\textbackslash}rm {CO}\}N\{{\textbackslash}rm {CEPT}\}{\textbackslash}, 1.0\$},
	volume = {513},
	issn = {0035-8711, 1365-2966},
	url = {http://arxiv.org/abs/2112.01508},
	doi = {10.1093/mnras/stac568},
	abstract = {We present version 1.0 of the cosmological simulation code \${\textbackslash}scriptstyle\{{\textbackslash}rm {CO}\}N\{{\textbackslash}rm {CEPT}\}\$, designed for simulations of large-scale structure formation. \${\textbackslash}scriptstyle\{{\textbackslash}rm {CO}\}N\{{\textbackslash}rm {CEPT}\}{\textbackslash}, 1.0\$ contains a P\${\textasciicircum}3\$M gravity solver, with the short-range part implemented using a novel (sub)tiling strategy, coupled with individual and adaptive particle time-stepping. A primary objective of \${\textbackslash}scriptstyle\{{\textbackslash}rm {CO}\}N\{{\textbackslash}rm {CEPT}\}\$ is ease of use. To this end, it has built-in initial condition generation and can produce output in the form of snapshots, power spectra and direct visualisations. \${\textbackslash}scriptstyle\{{\textbackslash}rm {CO}\}N\{{\textbackslash}rm {CEPT}\}\$ is the first massively parallel cosmological simulation code written in Python. Despite of this, excellent performance is obtained, even comparing favourably to other codes such as \${\textbackslash}scriptstyle\{{\textbackslash}rm {GADGET}\}\$ at similar precision, in the case of low to moderate clustering. By means of power spectrum comparisons we find extraordinary good agreement between \${\textbackslash}scriptstyle\{{\textbackslash}rm {CO}\}N\{{\textbackslash}rm {CEPT}\}{\textbackslash}, 1.0\$ and \${\textbackslash}scriptstyle\{{\textbackslash}rm {GADGET}\}\$. At large and intermediate scales the codes agree to well below the per mille level, while the agreement at the smallest scales probed (\$k {\textbackslash}sim 13{\textbackslash}, h/\{{\textbackslash}rm Mpc\}\$) is of the order of \$1{\textbackslash}, {\textbackslash}\%\$. The \${\textbackslash}scriptstyle\{{\textbackslash}rm {CO}\}N\{{\textbackslash}rm {CEPT}\}\$ code is openly released and comes with a robust installation script as well as thorough documentation.},
	pages = {991--1014},
	number = {1},
	journaltitle = {Monthly Notices of the Royal Astronomical Society},
	author = {Dakin, Jeppe and Hannestad, Steen and Tram, Thomas},
	urldate = {2026-08-03},
	date = {2022-04-27},
	eprinttype = {arxiv},
	eprint = {2112.01508 [astro-ph.CO]},
	keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics, Astrophysics - Instrumentation and Methods for Astrophysics},
}

@article{loverde_extended_2008,
	title = {Extended Limber Approximation},
	volume = {78},
	issn = {1550-7998, 1550-2368},
	url = {http://arxiv.org/abs/0809.5112},
	doi = {10.1103/PhysRevD.78.123506},
	abstract = {We develop a systematic derivation for the Limber approximation to the angular cross-power spectrum of two random fields, as a series expansion in 1/({\textbackslash}ell+1/2). This extended Limber approximation can be used to test the accuracy of the Limber approximation and to improve the rate of convergence at large {\textbackslash}ell's. We show that the error in ordinary Limber approximation is O(1/{\textbackslash}ell{\textasciicircum}2). We also provide a simple expression for the second order correction to the Limber formula, which improves the accuracy to O(1/{\textbackslash}ell{\textasciicircum}4). This correction can be especially useful for narrow redshift bins, or samples with small redshift overlap, for which the zeroth order Limber formula has a large error. We also point out that using {\textbackslash}ell instead of ({\textbackslash}ell+1/2), as is often done in the literature, spoils the accuracy of the approximation to O(1/{\textbackslash}ell).},
	pages = {123506},
	number = {12},
	journaltitle = {Physical Review D},
	shortjournal = {Phys. Rev. D},
	author = {{LoVerde}, Marilena and Afshordi, Niayesh},
	urldate = {2026-07-28},
	date = {2008-12-03},
	eprinttype = {arxiv},
	eprint = {0809.5112 [astro-ph]},
	keywords = {Astrophysics},
}

@misc{sullivan_methods_2024,
	title = {Methods for {CMB} map analysis},
	url = {http://arxiv.org/abs/2410.12951},
	doi = {10.48550/arXiv.2410.12951},
	abstract = {This introductory guide aims to provide insight to new researchers in the field of cosmic microwave background ({CMB}) map analysis on best practices for several common procedures. We will discuss common map-modifying procedures such as masking, downgrading resolution, the effect of the beam and the pixel window function, and adding white noise. We will explore how these modifications affect the final power spectrum measured from a map. This guide aims to describe the best way to perform each of these procedures, when the different steps and measures should be carried out, and the effects of incorrectly performing or applying any of them.},
	number = {{arXiv}:2410.12951},
	publisher = {{arXiv}},
	author = {Sullivan, Raelyn Marguerite and Hergt, Lukas Tobias and Scott, Douglas},
	urldate = {2026-07-28},
	date = {2024-11-28},
	eprinttype = {arxiv},
	eprint = {2410.12951 [astro-ph.CO]},
	keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics},
}

