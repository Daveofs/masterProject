\newlabel{tab:training}{{3.2}{31}{}{table.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Training and validation loss of the transfer-function emulator (squared error on $T$, without the $L_2$ term; 15-step rolling mean). Both curves coincide and plateau within the first $\sim 10^4$ steps; the best validation loss corresponds to an RMS emulation error of $\approx 1.4\%$ on $T(\ell , s)$.}}{32}{}\protected@file@percent }
\newlabel{fig:transfer_loss}{{3.2}{32}{}{figure.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Full-sky shell $C_\ell $ ratio to truth for the transfer pipeline, pooled per redshift bin (10 cosmologies $\times $ 5 shells; median and 16--84\% band, Sec.~\ref {sec:res-protocol}). Gray: uncorrected Disco-DJ; blue: corrected. The correction holds the ratio within a few percent out to $\ell = 3000$ wherever a deficit exists, and correctly leaves the already-accurate distant bin (right) untouched.}}{32}{}\protected@file@percent }
