\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Evolution of the density parameters $\Omega _i = \rho _i/\rho _{\rm  tot}$ for photons ($\gamma $), cold dark matter, baryons, a cosmological constant, and three neutrino mass states $m_{\nu _1}=0$, $m_{\nu _2}=0.009$, $m_{\nu _3}=0.05$~eV (red curves), computed with \textsc  {class} (\texttt  {vis/plot\_neutrino\_background.py}); cf.\ \blx@tocontentsinit {0}\cite {lesgourgues_massive_2006}. Radiation dominates before the equality epoch $a_{\mathrm  {eq}}$ (dashed, $z_{\mathrm  {eq}} \approx 3400$), matter after it, and $\Lambda $ today. Each massive state tracks the photons while relativistic and turns over to a matter-like dilution at its non-relativistic transition -- the heavier the state, the earlier the turn -- while the massless state $\nu _1$ keeps falling as radiation. It is this scale-dependent change in the energy budget that imprints the neutrino mass on $T(k)$.}}{7}{figure.1.1}\protected@file@percent }
\newlabel{fig:transfer_function}{{1.1}{7}{Evolution of the density parameters $\Omega _i = \rho _i/\rho _{\rm tot}$ for photons ($\gamma $), cold dark matter, baryons, a cosmological constant, and three neutrino mass states $m_{\nu _1}=0$, $m_{\nu _2}=0.009$, $m_{\nu _3}=0.05$~eV (red curves), computed with \textsc {class} (\texttt {vis/plot\_neutrino\_background.py}); cf.\ \cite {lesgourgues_massive_2006}. Radiation dominates before the equality epoch $a_{\mathrm {eq}}$ (dashed, $z_{\mathrm {eq}} \approx 3400$), matter after it, and $\Lambda $ today. Each massive state tracks the photons while relativistic and turns over to a matter-like dilution at its non-relativistic transition -- the heavier the state, the earlier the turn -- while the massless state $\nu _1$ keeps falling as radiation. It is this scale-dependent change in the energy budget that imprints the neutrino mass on $T(k)$}{figure.1.1}{}}
\newlabel{eq:cl}{{1.5}{7}{Matter Power Spectrum and Transfer Function}{equation.1.5}{}}
