\@writefile{lof}{\contentsline {figure}{\numberline {A.5}{\ignorespaces The two extremes of Figures~\ref {fig:cl_comparison} and~\ref {fig:cl_ratio_summary} in detail: shell~5 ($z = 0.065$--$0.079$, top) and shell~60 ($z = 1.986$--$2.099$, bottom). Upper panels show the two angular power spectra, lower panels their ratio; the dashed line marks \mbox  {$17\,\mathrm  {cMpc}/h$} projected onto that shell's comoving distance. Note the very different vertical scales: the nearby shell loses three quarters of its power by $\ell \sim 2000$, whereas the distant one stays within a percent of the reference everywhere, offset slightly below unity by the backscaling anchor at $z = 0$.}}{63}{figure.A.5}\protected@file@percent }
\newlabel{fig:cl_ratio_shells}{{A.5}{63}{The two extremes of Figures~\ref {fig:cl_comparison} and~\ref {fig:cl_ratio_summary} in detail: shell~5 ($z = 0.065$--$0.079$, top) and shell~60 ($z = 1.986$--$2.099$, bottom). Upper panels show the two angular power spectra, lower panels their ratio; the dashed line marks \mbox {$17\,\mathrm {cMpc}/h$} projected onto that shell's comoving distance. Note the very different vertical scales: the nearby shell loses three quarters of its power by $\ell \sim 2000$, whereas the distant one stays within a percent of the reference everywhere, offset slightly below unity by the backscaling anchor at $z = 0$}{figure.A.5}{}}
