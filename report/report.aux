\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces The two ingredients of the crossing test. (a) The box is replicated around the central observer until the ball of radius $\chi _{\max }$ is covered; replicas that cannot intersect the current step's annulus are rejected wholesale via Eq.~\eqref  {eq:replica_bounds}. (b) Within one step, the lightcone front shrinks from $R_j$ to $R_{j+1}$ (shaded annulus) while each particle moves from $\mathbf  {R}_0$ to $\mathbf  {R}_1$; both radii are interpolated linearly (Eq.~\ref {eq:scalar_interp}) and the closed-form crossing (Eq.~\ref {eq:vx_formula}) is accepted if $v^\ast \in [0,1)$, guaranteeing each particle is counted at most once per replica.}}{20}{figure.2.4}\protected@file@percent }
\newlabel{fig:crossing}{{2.4}{20}{The two ingredients of the crossing test. (a) The box is replicated around the central observer until the ball of radius $\chi _{\max }$ is covered; replicas that cannot intersect the current step's annulus are rejected wholesale via Eq.~\eqref {eq:replica_bounds}. (b) Within one step, the lightcone front shrinks from $R_j$ to $R_{j+1}$ (shaded annulus) while each particle moves from $\mathbf {R}_0$ to $\mathbf {R}_1$; both radii are interpolated linearly (Eq.~\ref {eq:scalar_interp}) and the closed-form crossing (Eq.~\ref {eq:vx_formula}) is accepted if $v^\ast \in [0,1)$, guaranteeing each particle is counted at most once per replica}{figure.2.4}{}}
