\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Weak-lensing convergence $C_\ell $ ratio to truth for the transfer pipeline (UFalcon integration \blx@tocontentsinit {0}\cite {sgier_fast_2018}; DES-Y3 source bins 1, left, and 4, right; median and 16--84\% band across the 30 evaluation cosmologies). The corrected lightcones (blue) hold within half a percent of the reference across the whole band, where the uncorrected baseline (gray) has lost \mbox  {$43\%$} (bin~1) and \mbox  {$20\%$} (bin~4) of the power by \mbox  {$\ell = 1500$}. Both \mbox  {$\kappa $} maps are built at the resolution of the shells that feed them (\mbox  {$N_{\mathrm  {side}}=512$}, \mbox  {$\ell \le 1500$}), so the band shown is exactly the band the correction is defined on.}}{41}{figure.3.7}\protected@file@percent }
\newlabel{fig:transfer_kappa}{{3.7}{41}{Weak-lensing convergence $C_\ell $ ratio to truth for the transfer pipeline (UFalcon integration \cite {sgier_fast_2018}; DES-Y3 source bins 1, left, and 4, right; median and 16--84\% band across the 30 evaluation cosmologies). The corrected lightcones (blue) hold within half a percent of the reference across the whole band, where the uncorrected baseline (gray) has lost \mbox {$43\%$} (bin~1) and \mbox {$20\%$} (bin~4) of the power by \mbox {$\ell = 1500$}. Both \mbox {$\kappa $} maps are built at the resolution of the shells that feed them (\mbox {$N_{\mathrm {side}}=512$}, \mbox {$\ell \le 1500$}), so the band shown is exactly the band the correction is defined on}{figure.3.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Convergence-map moments per evaluation cosmology for the transfer pipeline (top: source bin 1; bottom: bin 4). The corrected variance tracks the truth; skewness and excess kurtosis close only part of the gap -- consistent with Figure~\ref {fig:transfer_moments}.}}{42}{figure.3.8}\protected@file@percent }
\newlabel{fig:transfer_kappa_moments}{{3.8}{42}{Convergence-map moments per evaluation cosmology for the transfer pipeline (top: source bin 1; bottom: bin 4). The corrected variance tracks the truth; skewness and excess kurtosis close only part of the gap -- consistent with Figure~\ref {fig:transfer_moments}}{figure.3.8}{}}
