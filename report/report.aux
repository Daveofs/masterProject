\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Kick--drift--kick ``umbrella'' diagram of \textsc  {PkdGrav3}'s hierarchical multi-stepping over one base time step (schematic redraw after \blx@tocontentsinit {0}\cite {potter_pkdgrav3_2016}). Each lower rung halves the step size, and only the particles active on that rung are advanced at its sub-steps (red arches). The tree built for the slow, inactive particles is reused across many of these short sub-steps (blue arrows); only the small ``very active'' subset gets its own frequently-rebuilt tree, which keeps tree construction from dominating the runtime.}}{9}{}\protected@file@percent }
\newlabel{fig:pkd_rungs}{{1.3}{9}{}{figure.1.3}{}}
