\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces The straight-line interpolant of Eq.~\eqref  {eq:linear_interpolant} used for conditional flow matching \blx@tocontentsinit {0}\cite {lipman_flow_2023}: training regresses the network's velocity $v_\theta (x_t, t)$ onto the constant per-sample velocity $u_t = x_1 - x_0$; sampling integrates $\dot  {x}=v_\theta $ from $t=0$ to $t=1$. When $x_0$ is chosen close to $x_1$ -- as in Sec.~\ref {subsec:pipe-unet-flow}, where $x_0$ is the low-fidelity map itself rather than noise -- the trajectory is nearly straight and a handful of Euler steps suffice.}}{14}{figure.1.5}\protected@file@percent }
\newlabel{fig:flow_interp}{{1.5}{14}{The straight-line interpolant of Eq.~\eqref {eq:linear_interpolant} used for conditional flow matching \cite {lipman_flow_2023}: training regresses the network's velocity $v_\theta (x_t, t)$ onto the constant per-sample velocity $u_t = x_1 - x_0$; sampling integrates $\dot {x}=v_\theta $ from $t=0$ to $t=1$. When $x_0$ is chosen close to $x_1$ -- as in Sec.~\ref {subsec:pipe-unet-flow}, where $x_0$ is the low-fidelity map itself rather than noise -- the trajectory is nearly straight and a handful of Euler steps suffice}{figure.1.5}{}}
