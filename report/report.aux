\@writefile{lof}{\contentsline {figure}{\numberline {3.10}{\ignorespaces Full-sky shell $C_\ell $ ratio to truth for the flow pipeline (same construction as Figure~\ref {fig:transfer_cl}; note the evaluation resolution $N_{\mathrm  {side}}=512$, hence $\ell \lesssim 1500$). The correction restores the up-to-20\% deficit of the nearest bin to sub-percent level over most of the range, degrading only towards the reconstruction band limit.}}{44}{figure.3.10}\protected@file@percent }
\newlabel{fig:flow_cl}{{3.10}{44}{Full-sky shell $C_\ell $ ratio to truth for the flow pipeline (same construction as Figure~\ref {fig:transfer_cl}; note the evaluation resolution $N_{\mathrm {side}}=512$, hence $\ell \lesssim 1500$). The correction restores the up-to-20\% deficit of the nearest bin to sub-percent level over most of the range, degrading only towards the reconstruction band limit}{figure.3.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.11}{\ignorespaces One-point moments versus shell depth for the flow pipeline (median and 16--84\% band across up to 64 held-out patches per shell). Unlike the transfer correction (Figure~\ref {fig:transfer_moments}), the flow restores skewness and excess kurtosis onto the truth, with a slight overshoot on the sparsest shell.}}{44}{figure.3.11}\protected@file@percent }
\newlabel{fig:flow_moments}{{3.11}{44}{One-point moments versus shell depth for the flow pipeline (median and 16--84\% band across up to 64 held-out patches per shell). Unlike the transfer correction (Figure~\ref {fig:transfer_moments}), the flow restores skewness and excess kurtosis onto the truth, with a slight overshoot on the sparsest shell}{figure.3.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.12}{\ignorespaces Convergence $C_\ell $ ratio to truth for the flow pipeline (bins 1 and 4, as Figure~\ref {fig:transfer_kappa}). The correction holds the truth to within a percent out to \mbox  {$\ell \approx 600$} (bin~1) and \mbox  {$\ell \approx 1000$} (bin~4), then degrades smoothly towards the \mbox  {$N_{\mathrm  {side}}=512$} band limit, where the reconstruction has least power to supply.}}{45}{figure.3.12}\protected@file@percent }
\newlabel{fig:flow_kappa}{{3.12}{45}{Convergence $C_\ell $ ratio to truth for the flow pipeline (bins 1 and 4, as Figure~\ref {fig:transfer_kappa}). The correction holds the truth to within a percent out to \mbox {$\ell \approx 600$} (bin~1) and \mbox {$\ell \approx 1000$} (bin~4), then degrades smoothly towards the \mbox {$N_{\mathrm {side}}=512$} band limit, where the reconstruction has least power to supply}{figure.3.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.13}{\ignorespaces Convergence-map moments per evaluation cosmology for the flow pipeline (top: bin 1; bottom: bin 4). Corrected variance, skewness and excess kurtosis all coincide with the truth across the full held-out set, the residual undershoot being at the percent level even for the kurtosis.}}{45}{figure.3.13}\protected@file@percent }
\newlabel{fig:flow_kappa_moments}{{3.13}{45}{Convergence-map moments per evaluation cosmology for the flow pipeline (top: bin 1; bottom: bin 4). Corrected variance, skewness and excess kurtosis all coincide with the truth across the full held-out set, the residual undershoot being at the percent level even for the kurtosis}{figure.3.13}{}}
