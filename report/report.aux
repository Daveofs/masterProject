\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Full-sky shell $C_\ell $ ratio to truth for the transfer pipeline, pooled per redshift bin (30 cosmologies $\times $ 5 shells; median and 16--84\% band, Sec.~\ref {sec:res-protocol}). Gray: uncorrected \textsc  {Disco-DJ}; blue: corrected. Note the differing $y$-scales: the nearest bin (left) spans a $20\%$ deficit, the others $\lesssim 3\%$ and $\lesssim 1\%$. With the onset at $17\,\mathrm  {Mpc}/h$ the correction acts in both the nearest and the middle bin, lifting the nearest from $0.77$ to $1.00$ at $\ell \sim 1500$ and the middle from $0.97$ to $1.00$. In the right-hand panel the grey and blue curves are almost coincident: the correction acts on most of these shells but finds \mbox  {$T$} within a fraction of a percent of unity, so the two separate by only \mbox  {$0.1\%$} at \mbox  {$\ell = 1000$} and are indistinguishable below \mbox  {$\ell \approx 800$}.}}{40}{figure.3.5}\protected@file@percent }
\newlabel{fig:transfer_cl}{{3.5}{40}{Full-sky shell $C_\ell $ ratio to truth for the transfer pipeline, pooled per redshift bin (30 cosmologies $\times $ 5 shells; median and 16--84\% band, Sec.~\ref {sec:res-protocol}). Gray: uncorrected \textsc {Disco-DJ}; blue: corrected. Note the differing $y$-scales: the nearest bin (left) spans a $20\%$ deficit, the others $\lesssim 3\%$ and $\lesssim 1\%$. With the onset at $17\,\mathrm {Mpc}/h$ the correction acts in both the nearest and the middle bin, lifting the nearest from $0.77$ to $1.00$ at $\ell \sim 1500$ and the middle from $0.97$ to $1.00$. In the right-hand panel the grey and blue curves are almost coincident: the correction acts on most of these shells but finds \mbox {$T$} within a fraction of a percent of unity, so the two separate by only \mbox {$0.1\%$} at \mbox {$\ell = 1000$} and are indistinguishable below \mbox {$\ell \approx 800$}}{figure.3.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Full-sky one-point moments versus shell depth for the transfer pipeline (median and 16--84\% band across the 30 evaluation cosmologies). The bottom row gives the ratio to truth. The correction recovers the variance deficit almost entirely, and only nudges skewness and excess kurtosis: rescaling mode amplitudes cannot create the phase correlations the higher moments measure, so most of that gap survives.}}{40}{figure.3.6}\protected@file@percent }
\newlabel{fig:transfer_moments}{{3.6}{40}{Full-sky one-point moments versus shell depth for the transfer pipeline (median and 16--84\% band across the 30 evaluation cosmologies). The bottom row gives the ratio to truth. The correction recovers the variance deficit almost entirely, and only nudges skewness and excess kurtosis: rescaling mode amplitudes cannot create the phase correlations the higher moments measure, so most of that gap survives}{figure.3.6}{}}
\@writefile{toc}{\contentsline {paragraph}{Weak lensing.}{40}{section*.39}\protected@file@percent }
\abx@aux@cite{0}{sgier_fast_2018}
