\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Angular power spectra of four shells spanning the lightcone, for the \textsc  {Disco-DJ} run (solid) and the reference \textsc  {CosmoGridV1} lightcone (dashed), at $N_{\mathrm  {side}} = 2048$ (cosmology \texttt  {cosmo\_000001}, PM grid $L_{\mathrm  {box}}/N_{\mathrm  {pm}} = 0.54\,\mathrm  {cMpc}/h$). Colour identifies the shell, line style the simulation. Dashed vertical markers show where the measured deficit onset scale of \mbox  {$17\,\mathrm  {cMpc}/h$} falls on each shell. The two simulations track each other over the whole range except at high $\ell $ on the nearer shells, where \textsc  {Disco-DJ}'s mesh-limited force resolution costs it power.}}{35}{figure.3.2}\protected@file@percent }
\newlabel{fig:cl_comparison}{{3.2}{35}{Angular power spectra of four shells spanning the lightcone, for the \textsc {Disco-DJ} run (solid) and the reference \textsc {CosmoGridV1} lightcone (dashed), at $N_{\mathrm {side}} = 2048$ (cosmology \texttt {cosmo\_000001}, PM grid $L_{\mathrm {box}}/N_{\mathrm {pm}} = 0.54\,\mathrm {cMpc}/h$). Colour identifies the shell, line style the simulation. Dashed vertical markers show where the measured deficit onset scale of \mbox {$17\,\mathrm {cMpc}/h$} falls on each shell. The two simulations track each other over the whole range except at high $\ell $ on the nearer shells, where \textsc {Disco-DJ}'s mesh-limited force resolution costs it power}{figure.3.2}{}}
\@writefile{toc}{\contentsline {paragraph}{The backscaling trade-off.}{35}{section*.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces The same four shells as Figure~\ref {fig:cl_comparison}, shown as the ratio of Eq.~\eqref  {eq:shell_validation_ratio}, which resolves differences invisible on a six-decade logarithmic axis. At \mbox  {$\ell \lesssim 100$} all four shells scatter about unity with no systematic offset, within a few tenths of a percent on the nearer shells, degrading to a few percent below \mbox  {$\ell \approx 20$} on the most distant ones, where few independent modes contribute per multipole. That this residual is noise shrinking with mode count, rather than a coherent offset, is the result that validates the shell builder, while the small-scale deficit sets in at a fixed comoving scale and therefore at a higher multipole for each more distant shell. The upturn at the highest multipoles on shells~5 and~60 is the common shot-noise floor of the two runs, not recovered structure.}}{36}{figure.3.3}\protected@file@percent }
\newlabel{fig:cl_ratio_summary}{{3.3}{36}{The same four shells as Figure~\ref {fig:cl_comparison}, shown as the ratio of Eq.~\eqref {eq:shell_validation_ratio}, which resolves differences invisible on a six-decade logarithmic axis. At \mbox {$\ell \lesssim 100$} all four shells scatter about unity with no systematic offset, within a few tenths of a percent on the nearer shells, degrading to a few percent below \mbox {$\ell \approx 20$} on the most distant ones, where few independent modes contribute per multipole. That this residual is noise shrinking with mode count, rather than a coherent offset, is the result that validates the shell builder, while the small-scale deficit sets in at a fixed comoving scale and therefore at a higher multipole for each more distant shell. The upturn at the highest multipoles on shells~5 and~60 is the common shot-noise floor of the two runs, not recovered structure}{figure.3.3}{}}
