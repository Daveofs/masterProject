\@writefile{lot}{\contentsline {table}{\numberline {A.1}{\ignorespaces The 30 held-out validation cosmologies and their varied parameters (from each run's \texttt  {params.yml}; all other parameters are fixed across the \textsc  {CosmoGridV1} grid, Sec.~\ref {sec:cosmogrid}). All 30 form the shared evaluation set used for the full-sky and weak-lensing figures in this chapter.}}{58}{table.A.1}\protected@file@percent }
\newlabel{tab:heldout}{{A.1}{58}{The 30 held-out validation cosmologies and their varied parameters (from each run's \texttt {params.yml}; all other parameters are fixed across the \textsc {CosmoGridV1} grid, Sec.~\ref {sec:cosmogrid}). All 30 form the shared evaluation set used for the full-sky and weak-lensing figures in this chapter}{table.A.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A.2}Cosmology Grid}{59}{section.A.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces The 198 runnable grid cosmologies (gray) and the 30 held-out validation cosmologies (blue) in the sampled $w$CDM parameter space (\texttt  {ml/analysis/plot\_cosmo\_params.py}). The held-out set spans the full ranges of $\Omega _m$, $\sigma _8$, $w_0$, $H_0$, $n_s$, and $\Omega _b$, so the reported performance probes genuine interpolation across the grid, not proximity to training cosmologies.}}{59}{figure.A.1}\protected@file@percent }
\newlabel{fig:heldout_params}{{A.1}{59}{The 198 runnable grid cosmologies (gray) and the 30 held-out validation cosmologies (blue) in the sampled $w$CDM parameter space (\texttt {ml/analysis/plot\_cosmo\_params.py}). The held-out set spans the full ranges of $\Omega _m$, $\sigma _8$, $w_0$, $H_0$, $n_s$, and $\Omega _b$, so the reported performance probes genuine interpolation across the grid, not proximity to training cosmologies}{figure.A.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A.3}Patches}{60}{section.A.3}\protected@file@percent }
\newlabel{app:patches}{{A.3}{60}{Patches}{section.A.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.2}{\ignorespaces Example $256^2$ patches for the transfer pipeline at $N_{\mathrm  {side}}=512$ (rows: shells of increasing depth, drawn from different held-out cosmologies; columns: \textsc  {Disco-DJ}, corrected, \textsc  {CosmoGridV1}, and the per-patch 2D power ratio). Phases are preserved, so corrected and low show identical structures; only the small-scale amplitude changes. On the two deepest rows the \texttt  {low/high} curve is hidden beneath \texttt  {corrected/high}: there $\ell _{\min }(s) > \ell _{\max }$, so no correction is applied and the two are identical.}}{60}{figure.A.2}\protected@file@percent }
\newlabel{fig:transfer_patches}{{A.2}{60}{Example $256^2$ patches for the transfer pipeline at $N_{\mathrm {side}}=512$ (rows: shells of increasing depth, drawn from different held-out cosmologies; columns: \textsc {Disco-DJ}, corrected, \textsc {CosmoGridV1}, and the per-patch 2D power ratio). Phases are preserved, so corrected and low show identical structures; only the small-scale amplitude changes. On the two deepest rows the \texttt {low/high} curve is hidden beneath \texttt {corrected/high}: there $\ell _{\min }(s) > \ell _{\max }$, so no correction is applied and the two are identical}{figure.A.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.3}{\ignorespaces Held-out test patches for the flow pipeline (rows: shells 5--50; columns: \textsc  {Disco-DJ}, flow-corrected, \textsc  {CosmoGridV1}, per-patch 2D power ratio). The corrected sample restores both the visual texture and the small-scale power that the low maps lack. All three pipelines draw these rows from one shared plan (\texttt  {ml/analysis/example\_patches.py}), so Figures~\ref {fig:transfer_patches}, \ref {fig:flow_patches} and~\ref {fig:diff_patches} show the \emph  {same} five patches of sky, at the same shells and orientations, and can be compared row by row; each is cut from that pipeline's own full-sky reconstruction rather than from an isolated training tile. The elongated patterns are gone in this version: they were not a property of the models but a data-preparation bug, in which full-sky shells stored in \textsc  {ring} order were degraded to $N_{\mathrm  {side}}=512$ under a \textsc  {nested} assumption, so \texttt  {ud\_grade} averaged pixels that are not sky neighbours. Every $N_{\mathrm  {side}}=512$ map was regenerated and both generative models retrained on the corrected data.}}{61}{figure.A.3}\protected@file@percent }
\newlabel{fig:flow_patches}{{A.3}{61}{Held-out test patches for the flow pipeline (rows: shells 5--50; columns: \textsc {Disco-DJ}, flow-corrected, \textsc {CosmoGridV1}, per-patch 2D power ratio). The corrected sample restores both the visual texture and the small-scale power that the low maps lack. All three pipelines draw these rows from one shared plan (\texttt {ml/analysis/example\_patches.py}), so Figures~\ref {fig:transfer_patches}, \ref {fig:flow_patches} and~\ref {fig:diff_patches} show the \emph {same} five patches of sky, at the same shells and orientations, and can be compared row by row; each is cut from that pipeline's own full-sky reconstruction rather than from an isolated training tile. The elongated patterns are gone in this version: they were not a property of the models but a data-preparation bug, in which full-sky shells stored in \textsc {ring} order were degraded to $N_{\mathrm {side}}=512$ under a \textsc {nested} assumption, so \texttt {ud\_grade} averaged pixels that are not sky neighbours. Every $N_{\mathrm {side}}=512$ map was regenerated and both generative models retrained on the corrected data}{figure.A.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.4}{\ignorespaces Held-out test patches for the diffusion pipeline (layout as Figure~\ref {fig:flow_patches}). The small-scale structure of the corrected column is generated from noise, conditioned on the low patch, statistically matched to the truth rather than phase-matched.}}{62}{figure.A.4}\protected@file@percent }
\newlabel{fig:diff_patches}{{A.4}{62}{Held-out test patches for the diffusion pipeline (layout as Figure~\ref {fig:flow_patches}). The small-scale structure of the corrected column is generated from noise, conditioned on the low patch, statistically matched to the truth rather than phase-matched}{figure.A.4}{}}
