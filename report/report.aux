\@writefile{lof}{\contentsline {figure}{\numberline {3.17}{\ignorespaces One-point moments versus shell depth for the diffusion pipeline (as Figure~\ref {fig:flow_moments}). Most of the non-Gaussianity gap is closed, with a slight undershoot on the sparsest shells.}}{43}{}\protected@file@percent }
\newlabel{fig:diff_moments}{{3.17}{43}{}{figure.3.17}{}}
